PORT=3000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL (see docker-compose.yml at the repo root)
DATABASE_URL=postgres://projects:projects@localhost:5432/project_s
# Local development syncs tables to the entities. The Docker image sets
# DB_SYNCHRONIZE=false and DB_MIGRATIONS_RUN=true instead.
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false
# "true" (verified SSL), "no-verify", or empty for none. Hosted databases
# reached over the public internet (e.g. Neon) usually need "true".
DB_SSL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated emails allowed to register. Empty = anyone (fine locally;
# set it when the app is public).
ALLOWED_EMAILS=

# Claude API: screenshot import + natural-language screener. Empty = demo mode (sample data).
ANTHROPIC_API_KEY=

# Market data (Financial Modeling Prep). Leave empty to use built-in mock data.
FMP_API_KEY=

# Alerts
ALERT_POLL_SECONDS=30
# Email: RESEND_API_KEY (HTTPS API, works where SMTP is blocked) takes
# precedence over SMTP_URL. Mailpit from docker-compose catches SMTP mail at
# http://localhost:8025. Neither set = emails are only logged.
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Project S <alerts@project-s.local>

# Deployment only: number of reverse proxies in front of the app (for the
# client IP used by rate limiting). Use 0 when nothing sits in front.
TRUST_PROXY_HOPS=1
