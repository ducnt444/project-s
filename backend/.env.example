PORT=3000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL (see docker-compose.yml at the repo root)
DATABASE_URL=postgres://projects:projects@localhost:5432/project_s
# Auto-create/alter tables from entities. Set to false and use migrations in production.
DB_SYNCHRONIZE=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Claude API: screenshot import + natural-language screener. Empty = demo mode (sample data).
ANTHROPIC_API_KEY=

# Market data (Financial Modeling Prep). Leave empty to use built-in mock data.
FMP_API_KEY=

# Alerts
ALERT_POLL_SECONDS=30
# Mailpit from docker-compose catches all mail at http://localhost:8025. Empty = log only.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Project S <alerts@project-s.local>
